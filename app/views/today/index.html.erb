<div class="max-w-3xl mx-auto my-10 font-sans">
  <h1>Today</h1>

  <p><%= Date.current.strftime("%A, %B %-d, %Y") %></p>

  <hr>

  <h2 class="text-xl font-semibold mt-8 mb-4">Calendar</h2>

  <div data-testid="today-calendar">
    <% if @calendar_events.any? %>
      <% @calendar_events.each do |event| %>
        <div class="mb-3 rounded-lg border border-gray-200 p-3" data-testid="calendar-event">
          <div class="font-medium" data-testid="calendar-event-title">
            <%= event.title %>
          </div>

          <div class="text-sm text-gray-600" data-testid="calendar-event-time">
            <%= event.starts_at.strftime("%-I:%M %p") %>

            <% if event.ends_at.present? %>
              —
              <% if event.ends_at.to_date == event.starts_at.to_date %>
                <%= event.ends_at.strftime("%-I:%M %p") %>
              <% else %>
                <%= event.ends_at.strftime("%b %-d, %-I:%M %p") %>
              <% end %>
            <% end %>
          </div>

          <% if event.location.present? %>
            <div class="text-sm text-gray-500 mt-1" data-testid="calendar-event-location">
              📍 <%= event.location %>
            </div>
          <% end %>
        </div>
      <% end %>
    <% else %>
      <p data-testid="calendar-empty-state">No events today.</p>
    <% end %>
  </div>

  <hr>

  <h2>Daily Log</h2>

  <% if @daily_log.present? %>
    <pre class="whitespace-pre-wrap"><%= @daily_log.content %></pre>
  <% else %>
    <p>No daily log yet.</p>
  <% end %>

  <hr>

  <h2>Summary</h2>

  <% if @daily_log.present? %>
    <% if @daily_log.summary.present? %>
      <pre class="whitespace-pre-wrap"><%= @daily_log.summary %></pre>
    <% else %>
      <p>No summary available.</p>
    <% end %>
  <% else %>
    <p>No summary available because there is no daily log yet.</p>
  <% end %>
</div>